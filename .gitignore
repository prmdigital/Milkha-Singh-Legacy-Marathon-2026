.claude/
Thumbs.db
.DS_Store
dist/
*.zip

# Real credentials — never commit. Use api/config.sample.php as the template.
api/config.php
marathon-config.php

# The settings page writes a .bak beside the config before replacing it, and a
# temporary file while validating. On the server those live above public_html,
# but locally the config sits inside the repo — and they hold live credentials.
api/config.php.*
*.bak

# Images, videos and the content cache saved from the admin website editor live
# on the server only. The lock-down rules for the folder are committed.
uploads/site/*
!uploads/site/.htaccess

# Python bytecode from tools/annotate.py
__pycache__/
